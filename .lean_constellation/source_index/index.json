      ],
      "subtype": "abstract_statement",
      "summary": "For d ≥ 4, ceil((d+2)/2) ≤ s ≤ d−1, and n ≥ 2(d+1), the source constructs an s-witness (d+1)-uniform family of exact size choose(n−1,d)+choose(n−2(d+1−s)−2,2s−d−2), disproving the uniform witness conjecture.",
      "title": "Abstract counterexample statement",
      "updated_at": "2026-07-21T19:39:07Z"
    },
    "b_0006": {
