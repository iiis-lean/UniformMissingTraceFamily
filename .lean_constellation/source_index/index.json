      ],
      "subtype": "uniform_witness",
      "summary": "For n ≥ 2(d+1) and 0 ≤ s ≤ d, every s-witness family in choose([n],d+1) was conjectured to have cardinality at most choose(n−1,d).",
      "title": "Uniform witness conjecture",
      "updated_at": "2026-07-21T19:39:07Z"
    },
